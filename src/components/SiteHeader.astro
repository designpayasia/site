---
const navLinks = [
  { href: '/reports',   label: 'Reports' },
  { href: '/about',     label: 'About' },
  { href: '/contribute',label: 'Contribute' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <a href="/" class="site-header__mark" aria-label="Design Pay Asia — home">
    <!-- D″ master blob (400×400 viewBox, r=80 soft chamfer) -->
    <svg
      class="site-header__blob"
      viewBox="0 0 400 400"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M0 400 V133.14 A80 80 0 0 1 23.43 76.57 L76.57 23.43 A80 80 0 0 1 133.14 0 H200 A200 200 0 0 1 200 400 Z" />
    </svg>
    <span class="site-header__wordmark">Design Pay Asia</span>
  </a>

  <nav class="site-header__nav" aria-label="Main navigation">
    <ul class="site-header__nav-list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={['site-header__nav-link', { 'is-active': currentPath.startsWith(href) }]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    {/*
      The label names the control, not the destination state. A label like
      "Switch to dark theme" has to be kept in sync with the current theme, and
      the theme is decided before this markup is parsed — by the reader's OS
      unless they have chosen otherwise. A stable label is honest at first
      paint; the icon carries which way the switch will go.

      Rendered without a `hidden` fallback for no-JS readers: the OS preference
      still applies without any script, so the only thing lost is the override.
      A control that does nothing is worse than no control, so the script
      unhides it — see the inline script below.
    */}
    <button type="button" class="theme-toggle" aria-label="Switch colour theme" hidden>
      <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="4.2" />
        <path d="M12 1.8v3.2M12 19v3.2M4.8 4.8l2.3 2.3M16.9 16.9l2.3 2.3M1.8 12h3.2M19 12h3.2M4.8 19.2l2.3-2.3M16.9 7.1l2.3-2.3" />
      </svg>
    </button>
  </nav>
</header>

<script is:inline>
  (() => {
    const button = document.querySelector('.theme-toggle');
    if (!button) return;

    // Only shown once we know the click will do something.
    button.hidden = false;

    const root = document.documentElement;
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)');

    button.addEventListener('click', () => {
      // Read the rendered theme rather than a stored value: on first click
      // there is nothing stored, and the honest starting point is whatever the
      // reader is currently looking at.
      const current = root.dataset.theme || (systemDark.matches ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('dpa-theme', next);
      } catch {
        // Private browsing, or storage disabled. The choice still applies to
        // this page; it just will not survive navigation.
      }
    });

    // A reader who has never chosen keeps following their OS, including when
    // they change it mid-visit.
    systemDark.addEventListener('change', () => {
      try {
        if (localStorage.getItem('dpa-theme')) return;
      } catch {
        return;
      }
      root.removeAttribute('data-theme');
    });
  })();
</script>

<style>
  /* Sits with the nav links rather than apart from them: it is a control for
     reading the site, not a setting. 44px to match .btn in global.css. */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    color: var(--color-ink-subtle);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--color-border-subtle);
    color: var(--color-workhorse);
  }

  .theme-toggle:focus-visible {
    outline: 3px solid var(--color-signal-fill);
    outline-offset: 3px;
  }

  .theme-toggle__icon {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  /* Driven by tokens, not a media query, so the sitewide theme has one source
     of truth — see _semantic.css and _dark.css. */
  .theme-toggle__icon--sun {
    display: var(--theme-icon-sun);
  }

  .theme-toggle__icon--moon {
    display: var(--theme-icon-moon);
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    padding-block: var(--space-4);
    padding-inline: var(--space-8);
    max-width: var(--site-max-width);
    margin-inline: auto;
    width: 100%;
  }

  .site-header__mark {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-workhorse);
    flex-shrink: 0;
  }

  .site-header__blob {
    height: 2rem;
    width: auto;
    fill: var(--color-signal);
    transition: opacity var(--transition-hover);
  }

  .site-header__mark:hover .site-header__blob {
    opacity: 0.8;
  }

  .site-header__wordmark {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-normal);
    line-height: 1;
  }

  .site-header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
  }

  .site-header__nav-link {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-medium);
    color: var(--color-workhorse);
    text-decoration: none;
    padding-block: var(--space-1);
    border-bottom: 1.5px solid transparent;
    transition: color var(--transition-hover), border-color var(--transition-hover);
  }

  .site-header__nav-link:hover,
  .site-header__nav-link.is-active {
    color: var(--color-signal-text);
    border-bottom-color: var(--color-signal-text);
  }

  /* Mobile — collapse wordmark, keep nav readable */
  @media (max-width: 767px) {
    .site-header {
      padding-inline: var(--space-4);
    }

    .site-header__wordmark {
      display: none;
    }

    .site-header__nav-list {
      gap: var(--space-4);
    }
  }
  .site-header__nav-list {
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  @media (max-width: 767px) {
    .site-header {
      align-items: flex-start;
      flex-wrap: wrap;
      gap: var(--space-3);
    }

    .site-header__nav {
      width: 100%;
      min-width: 0;
    }

    .site-header__nav-list {
      gap: var(--space-2) var(--space-3);
      justify-content: flex-start;
      max-width: none;
    }

    .site-header__nav-link {
      font-size: 0.85rem;
    }
  }
</style>
