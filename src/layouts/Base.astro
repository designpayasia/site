---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title = 'Design Pay Asia',
  description = 'Southeast Asia\'s design pay conversation.',
  ogImage = '/og-default.png',
  ogType = 'website',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
// `new URL(x, base)` returns `x` unchanged (as an absolute URL) when `x` is
// already absolute, and resolves it against `base` otherwise — so this stays
// correct whether a caller passes '/og-default.png' or a full https:// URL.
const ogImageUrl = new URL(ogImage, Astro.site);
const cloudflareToken = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN;
---

<!doctype html>
{/*
  No data-theme attribute here. Its absence is what lets the reader's OS
  preference govern (see _dark.css); the script below adds it only for a reader
  who has explicitly chosen otherwise. A hardcoded value would override
  everyone's system setting on every page.
*/}
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Mobile browser chrome colour. A meta tag can't take a var(), so these
         are literal hex mirrors of --color-ambient: light mirrors
         --color-cream-50, dark mirrors --dark-ambient (--color-navy-900). If
         those primitives ever drift, these two lines are the place to check. -->
    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1c2e" media="(prefers-color-scheme: dark)" />

    {/*
      First thing in the head, before the stylesheets, and deliberately inline
      and synchronous. A reader who chose a theme must get it applied before
      first paint; a deferred or module script runs after, and they would watch
      the page flash the other theme on every navigation. Nothing here touches
      the DOM beyond the root attribute, so it cannot block on layout.
    */}
    <script is:inline>
      try {
        const stored = localStorage.getItem('dpa-theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      } catch {
        // Storage blocked. The OS preference still applies.
      }
    </script>
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageUrl} />
    <meta property="og:image:alt"   content="Design Pay Asia" />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale"      content="en_SG" />
    <meta property="og:site_name"   content="Design Pay Asia" />

    <!-- Twitter/X card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageUrl} />

    <!-- Favicons — regenerated from D″ master path when mark is ready -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Fonts — preconnect first, then load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap"
    />

    {cloudflareToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cloudflareToken })}
      />
    )}

    <slot name="head" />
  </head>
  <body class="site-body">
    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      <defs>
        <clipPath id="dpa-blob" clipPathUnits="objectBoundingBox">
          <path
            transform="scale(0.0025)"
            d="M0 400 V133.14 A80 80 0 0 1 23.43 76.57 L76.57 23.43 A80 80 0 0 1 133.14 0 H200 A200 200 0 0 1 200 400 Z"
          />
        </clipPath>
      </defs>
    </svg>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>

<style>
  .site-body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .site-body > main {
    flex: 1;
  }
</style>
</html>
