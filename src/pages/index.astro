---
import { getCollection } from 'astro:content';

import BigStat from '../components/BigStat.astro';
import Blob from '../components/Blob.astro';
import EntryCard from '../components/EntryCard.astro';
import Invitation from '../components/Invitation.astro';
import PullQuote from '../components/PullQuote.astro';
import Base from '../layouts/Base.astro';
import { assertMetricsHaveEvidence, buildEvidenceMap, getVisibleMetrics } from '../lib/evidence';

const [homepage] = await getCollection('site');

if (!homepage) {
  throw new Error('Missing site/homepage data entry.');
}

const reports = await getCollection('reports');
const publishedReports = reports
  .filter((report) => report.data.status === 'published')
  .sort((left, right) => right.data.publishedAt.getTime() - left.data.publishedAt.getTime());

// The page shows every published cycle, newest first, except that
// `featuredReportSlug` gets to lead the row. That slug is the only year-bound
// value on the page; everything else in the section below is read off the
// report entries, so a new cycle lands here by publishing its content file.
const featuredReports = [...publishedReports].sort((left, right) => {
  const featured = homepage.data.featuredReportSlug;
  return Number(right.data.slug === featured) - Number(left.data.slug === featured);
});

if (featuredReports.length === 0) {
  throw new Error('Missing published report entry for homepage.');
}

// A slug that matches nothing would silently fall back to newest-first, which
// looks correct and is not. Fail on the typo instead.
if (!featuredReports.some((report) => report.data.slug === homepage.data.featuredReportSlug)) {
  throw new Error(
    `homepage featuredReportSlug "${homepage.data.featuredReportSlug}" matches no published report.`,
  );
}

const evidenceEntries = await getCollection('evidence');
const evidenceMap = buildEvidenceMap(evidenceEntries);

const stats = getVisibleMetrics(homepage.data.stats);
assertMetricsHaveEvidence(stats, evidenceMap, 'site/homepage');

const heroStat =
  stats.find((stat) => stat.evidenceId === 'evidence:community-submissions-cumulative') ?? stats[0];
const heroEvidence = evidenceMap.get(heroStat.evidenceId);

if (!heroEvidence) {
  throw new Error(`Missing evidence entry for hero stat ${heroStat.evidenceId}.`);
}

const heroSource = heroEvidence.data.sourceName;
// The page's one outbound data link, read off the evidence entry rather than
// typed here, so the tracker moves in one place.
const poolHref = heroEvidence.data.sourceUrl;

const titleWords = homepage.data.heroTitle.trim().split(/\s+/);
const heroTitleHead = titleWords.slice(0, -1).join(' ');
const heroTitleSignal = titleWords.at(-1);

// Meta chips are derived from each report entry itself (hub.responses,
// markets), so a new cycle's card updates with no copy edit here.
const reportMeta = (report: (typeof featuredReports)[number]) => [
  `${report.data.hub.responses.value} ${report.data.hub.responses.label}`,
  `${report.data.markets.length} ${report.data.markets.length === 1 ? 'market' : 'markets'}`,
];
---

<Base
  title="Design Pay Asia - Southeast Asia's design pay conversation."
  description="Because pay is never just a number. It is context, power, and where the design industry is going."
>
  <main class="homepage">
    <section class="hero" aria-labelledby="homepage-title">
      <div class="hero__inner">
        <div class="hero__copy">
          <p class="hero__eyebrow label-mono">Since 2020</p>
          <h1 id="homepage-title" class="hero__title t-hero">
            {heroTitleHead} <span class="signal-word">{heroTitleSignal}</span>
          </h1>
          <p class="hero__sub">{homepage.data.heroSummary}</p>
          <div class="hero__ctas">
            <a href={homepage.data.heroCtaHref} class="btn btn--primary">
              {homepage.data.heroCtaLabel}
            </a>
            {
              homepage.data.heroSecondaryCtaLabel && homepage.data.heroSecondaryCtaHref && (
                <a href={homepage.data.heroSecondaryCtaHref} class="btn btn--secondary">
                  {homepage.data.heroSecondaryCtaLabel}
                </a>
              )
            }
          </div>
        </div>

        <div class="hero__stat">
          {/*
            Full-strength fill (no opacity reduction) via --color-stat-blob-fill, a
            surface-muted alias (see _semantic.css) that dark mode overrides to
            navy-800 rather than the general surface-muted navy-700 — navy-700
            fails AA against the ink text painted inside the blob (1.86:1). The
            BigStat label and source line below use --color-ink-subtle rather
            than --color-ink-muted for the same reason: ink-muted only clears AA
            against surface-muted in light mode (4.67:1) and fails outright in
            dark mode; ink-subtle clears both (7.47:1 light, 5.57:1 dark). See
            scripts/a11y-contrast.mjs.
          */}
          <Blob
            as="clip"
            aspect={1}
            fill="var(--color-stat-blob-fill)"
            class="hero__stat-shape"
          />
          <div class="hero__stat-content">
            <BigStat variant="hero"
              value={heroStat.value}
              unit={heroStat.unit}
              label={heroStat.label}
              color="workhorse"
              countUp
            />
            <p class="hero__stat-source label-mono">{heroSource}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="manifesto" aria-labelledby="manifesto-title">
      <div class="manifesto__inner">
        <p class="manifesto__eyebrow label-mono">Why this exists</p>
        <h2 id="manifesto-title" class="manifesto__title t-h2">
          Design pay in Southeast Asia has stayed private
        </h2>
        <div class="manifesto__body prose">
          <p>
            Employers know the market rate for a role. Designers usually don't, until an offer
            forces the question.
          </p>
          <p>
            Design Pay Asia asks designers to share what they actually earn, in the open, and
            publishes it as evidence anyone can check. The surveys have run since 2020, and every
            published report is built from designers who chose to answer honestly instead of
            comparing notes only in private.
          </p>
          <p>
            The reports are the evidence. What the industry does with them is the harder
            question, and it's one only the industry itself can answer.
          </p>
        </div>
        <div class="manifesto__quote prose-editorial">
          <PullQuote
            quote="DPA publishes the numbers and convenes the conversation."
            draftState="final"
          />
        </div>
      </div>
    </section>

    <section class="featured-report" aria-label="The reports">
      <div class="featured-report__inner">
        <p class="featured-report__eyebrow label-mono">The reports</p>
        <div class="featured-report__grid">
          {
            featuredReports.map((report) => (
              <EntryCard
                href={report.data.canonicalPath}
                year={report.data.year}
                kind={report.data.entryType}
                claim={report.data.hub.claim}
                highlight={{
                  value: report.data.hub.highlight.value,
                  unit: report.data.hub.highlight.unit,
                  label: report.data.hub.highlight.label,
                }}
                meta={reportMeta(report)}
              />
            ))
          }
        </div>
        <p class="featured-report__pool">
          Every report here is compiled from the same pool of raw submissions. The pool is
          anonymised, and it is public.
          <a href={poolHref}>Open the submissions tracker</a>
        </p>
      </div>
    </section>

    <Invitation question="Would you share what you earn?" questionDraft={false} ctaLabel="Add your pay" ctaHref="https://tally.so/r/3EDeGX" />
  </main>
</Base>

<style>
  .homepage {
    background: var(--color-ambient);
    color: var(--color-workhorse);
  }

  .hero {
    padding: var(--space-24) 0 0;
  }

  .hero__inner,
  .manifesto__inner,
  .featured-report__inner {
    max-width: var(--site-max-width);
    margin-inline: auto;
    padding-inline: var(--space-8);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-6);
    align-items: center;
    min-height: min(720px, calc(100vh - 160px));
  }

  .hero__copy {
    grid-column: 1 / 9;
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--color-ink-muted);
  }

  .hero__title {
    max-width: 14ch;
  }

  .hero__sub {
    max-width: 52ch;
    margin: var(--space-6) 0 0;
    color: var(--color-ink-subtle);
    font-size: var(--font-size-lg);
    line-height: 1.55;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  /* Buttons are now defined globally in src/styles/global.css */

  /* Hero blob-cropped stat remains 1:1 so the locked silhouette is never distorted. */
  .hero__stat {
    position: relative;
    grid-column: 9 / -1;
    aspect-ratio: 1;
    min-width: 0;
    overflow: hidden;
  }

  /* Gentle drift — shape and stat move together as one container. Transform-only,
     no will-change (the motion is slow enough not to need a compositing hint). */
  @media (prefers-reduced-motion: no-preference) {
    .hero__stat {
      animation: hero-stat-float 6s ease-in-out infinite alternate;
    }
  }

  /* Vertical only, 16px of travel over 6s, rising before it falls. Rate is
     what makes the motion readable, not distance: the original 8px across and
     16px down over 28s moved too slowly for anyone to notice it was
     animating, and the diagonal drift made the blob look loose in its column
     rather than buoyant. */
  @keyframes hero-stat-float {
    from {
      transform: translateY(var(--space-2));
    }
    to {
      transform: translateY(calc(-1 * var(--space-2)));
    }
  }

  .hero__stat-shape {
    position: absolute;
    inset: 0;
  }

  .hero__stat-content {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: center;
    height: 100%;
    min-height: 0;
    padding: var(--space-8);
    overflow-wrap: break-word;
  }

  .hero__stat-content > * {
    max-width: 100%;
    min-width: 0;
  }

  .hero__stat-source {
    margin: var(--space-4) 0 0;
    color: var(--color-ink-subtle);
  }

  /* BigStat's own label defaults to --color-ink-muted, which fails AA against
     --color-stat-blob-fill in dark mode (1.86:1) — see the Blob comment above.
     Reach-in scoped to the hero blob only; BigStat.astro's global label colour
     is untouched. */
  .hero__stat :global(.bigstat__label) {
    color: var(--color-ink-subtle);
  }

  .manifesto,
  .featured-report {
    padding: var(--space-24) 0;
  }

  .featured-report {
    border-top: 1px solid var(--color-border-subtle);
  }

  .manifesto__eyebrow,
  .featured-report__eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--color-ink-muted);
  }

  .manifesto__title {
    max-width: 16ch;
  }

  .manifesto__body {
    display: grid;
    gap: var(--space-6);
    margin: var(--space-8) 0 0;
    color: var(--color-ink-subtle);
  }

  .manifesto__body p {
    margin: 0;
  }

  .manifesto__quote {
    margin: var(--space-10) 0 0;
  }

  /* Same grid as /reports: one column on mobile, two from tablet up, every
     entry treated identically. A third cycle wraps onto the next row with
     nothing to change here. */
  .featured-report__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .featured-report__pool {
    margin: var(--space-8) 0 0;
    max-width: var(--zone-prose);
    color: var(--color-ink-muted);
  }

  .featured-report__pool a {
    color: var(--color-action);
    text-underline-offset: 0.2em;
  }

  .featured-report__pool a:hover {
    color: var(--color-ink);
  }

  @media (min-width: 768px) {
    .featured-report__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
      min-height: min(720px, calc(100vh - 160px));
    }

    .hero__copy,
    .hero__stat {
      grid-column: 1;
    }

    .hero__stat {
      /* Tighter than the ~389px desktop shape (4/12 columns at 1280 site-max) so
         the fixed-floor stat figure (see below) reads as a fill, not a mass. */
      width: min(100%, 360px);
      margin: 0 auto;
    }
  }

  /* BigStat's hero clamp prefers min(5cqi, 90cqi / (chars * 0.62)), which floors
     at 4rem for short values at any container under ~1280px wide — 5cqi never
     clears the floor in a ~300–350px blob, so the number renders the same
     ~64px whether the shape is 360px (tablet) or ~389px (desktop, 4/12 columns
     at the 1280 site-max). Override the same custom property BigStat itself
     sets (not a flat font-size) so the character-count overflow guard
     (90cqi / (chars * 0.62)) stays intact — a longer value still shrinks to
     fit instead of clipping. 6rem is a plain literal, matching BigStat's own
     clamp bounds (4rem/5rem/2.5rem/1.75rem are not tokenised either) — no existing
     type token sits at this value, and it rarely governs anyway: the guard is
     lower than 6rem for every realistic value/container in this range, so the
     guard is what actually renders. No upper breakpoint bound — this runs from
     tablet through desktop so the scale grows continuously instead of
     collapsing back to the 4rem floor past 900px. */
  @media (min-width: 768px) {
    .hero__stat :global(.bigstat--hero) {
      --_bigstat-size: clamp(
        4rem,
        min(6rem, calc(90cqi / (var(--_bigstat-chars, 6) * 0.62))),
        var(--type-stat-size)
      );
    }
  }

  @media (max-width: 767px) {
    .hero {
      padding-top: var(--space-16);
    }

    .hero__inner,
    .manifesto__inner,
    .featured-report__inner {
      padding-inline: var(--space-4);
    }

    .hero__title {
      font-size: clamp(2.9rem, 14vw, var(--t-display-mobile));
    }

    .hero__stat-content {
      padding: var(--space-5);
    }

    .manifesto__title {
      font-size: clamp(2.9rem, 14vw, var(--t-display-mobile));
    }
  }

  .hero__copy {
    min-width: 0;
  }

  .hero__title,
  .manifesto__title {
    overflow-wrap: break-word;
    hyphens: manual;
  }
</style>
