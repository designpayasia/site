---
import Base from '../layouts/Base.astro';
import ConversationBlock from '../components/ConversationBlock.astro';
import Invitation from '../components/Invitation.astro';
---

<Base
  title="Contribute - Design Pay Asia"
  description="Share your salary anonymously and help build a fairer, more transparent picture of design pay in Southeast Asia."
>
  <section class="contribute-page">
    <div class="contribute-page__inner">
      <p class="label-mono">Contribute</p>
      <h1 class="t-h2">Add your pay to the evidence.</h1>
      <p class="prose">
        The more designers share, the fairer the picture gets. Five minutes, anonymous, and every answer goes straight into the next report.
      </p>
    </div>
  </section>

  <ConversationBlock
    id="why-share"
    eyebrow="Why share"
    title="Pay talk makes pay fair"
    paragraphs={[
      "Design salaries in Southeast Asia are still a private conversation: no published bands, no ranges to check an offer against, no way to know if a number is fair. Every anonymous submission narrows that gap for the next designer who has to guess.",
      "The form asks for your role, your market, and what you're paid. No name, no email, no company required.",
    ]}
    metaEyebrow="The form"
    metaTitle="Anonymous"
    metaItems={[
      { label: 'Time', value: '~5 minutes' },
      { label: 'Privacy', value: 'No names, no emails' },
      { label: 'Feeds', value: 'The next report' },
    ]}
    metaNote="Any written answers are read for themes only, never quoted directly."
    draftState="final"
  />

  <ConversationBlock
    id="where-it-goes"
    eyebrow="After you submit"
    title="Where your number goes"
    paragraphs={[
      "Every submission feeds the next report cycle. It gets cleaned and checked against the market, then published only once a group clears a minimum size. Cohorts under 10 responses are never reported as an individual figure. They're suppressed instead, or published only as a marked small sample, with a note explaining why.",
      "Once a figure is published, it stays where you found it: report routes don't move between years, and every number carries the evidence record it came from, so anyone citing it can check the source.",
    ]}
    metaPosition="end"
    metaEyebrow="Go deeper"
    metaTitle="Where it goes"
    metaItems={[
      { label: 'Safety rules', value: 'How small cohorts stay protected', href: '/docs/data-safety' },
      { label: 'The cycle', value: 'Survey to publication', href: '/docs/run-a-cycle' },
      { label: 'Citing a number', value: 'Licence and attribution', href: '/docs/using-our-data' },
    ]}
    metaNote="Corrections take priority over new report work."
    draftState="final"
  />

  <Invitation
    question="What would you tell the next designer who has to guess?"
    questionDraft={false}
    ctaLabel="Share your pay"
    ctaHref="https://tally.so/r/3EDeGX"
  />
</Base>

<style>
  .contribute-page {
    padding-block: var(--space-24);
  }

  .contribute-page__inner {
    max-width: var(--site-max-width);
    margin-inline: auto;
    padding-inline: var(--space-8);
  }

  .contribute-page__inner h1 {
    margin-block: var(--space-6);
    max-width: 14ch;
  }

  @media (max-width: 767px) {
    .contribute-page {
      padding-inline: var(--space-4);
      padding-block: var(--space-16);
    }
  }
</style>
