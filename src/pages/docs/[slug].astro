---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs', ({ data }) => data.status === 'published');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, related, updated } = entry.data;

const updatedLabel = new Date(`${updated}T00:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={`${title} - Design Pay Asia`} description={summary}>
  <article class="doc">
    <div class="doc__inner">
      <p class="label-mono"><a href="/docs" class="doc__back">Docs</a></p>
      <h1>{title}</h1>
      <p class="prose doc__summary">{summary}</p>

      <div class="prose doc__body">
        <Content />
      </div>

      <footer class="doc__footer">
        <p class="label-mono doc__updated">Updated {updatedLabel}</p>
        {
          related.length > 0 && (
            <div class="doc__links">
              {related.map((link) => (
                <a href={link.href} class="doc__link">
                  {link.label}
                </a>
              ))}
            </div>
          )
        }
      </footer>
    </div>
  </article>
</Base>

<style>
  .doc {
    padding-block: var(--space-24);
  }

  .doc__inner {
    max-width: var(--site-max-width);
    margin-inline: auto;
    padding-inline: var(--space-8);
  }

  .doc__back {
    color: inherit;
    text-decoration: none;
  }

  .doc__back:hover {
    color: var(--color-action);
  }

  .doc__inner h1 {
    margin-block: var(--space-6);
    max-width: 20ch;
  }

  .doc__summary {
    color: var(--color-ink-muted);
  }

  .doc__body {
    margin-top: var(--space-12);
  }

  .doc__body :global(h2) {
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
  }

  .doc__body :global(h2:first-child) {
    margin-top: 0;
  }

  .doc__body :global(p),
  .doc__body :global(ul),
  .doc__body :global(ol) {
    margin-bottom: var(--space-4);
  }

  .doc__body :global(ul),
  .doc__body :global(ol) {
    padding-left: var(--space-5);
  }

  .doc__body :global(li + li) {
    margin-top: var(--space-2);
  }

  .doc__body :global(blockquote) {
    margin-block: var(--space-8);
    padding: var(--space-6);
    border-left: 4px solid var(--color-border-strong);
    background: var(--color-surface);
  }

  .doc__body :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  .doc__body :global(pre) {
    margin-block: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    overflow-x: auto;
  }

  .doc__body :global(table) {
    width: 100%;
    margin-block: var(--space-6);
    border-collapse: collapse;
    text-align: left;
  }

  .doc__body :global(th),
  .doc__body :global(td) {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  /* Markdown emits a bare <table> with nowhere to hang an overflow wrapper, so
     the table scrolls itself on narrow screens. Without this a wide table pushes
     the whole page sideways on a phone. */
  @media (max-width: 767px) {
    .doc {
      padding-inline: var(--space-4);
      padding-block: var(--space-16);
    }
  }

  @media (max-width: 600px) {
    .doc__body :global(table) {
      display: block;
      overflow-x: auto;
    }
  }

  .doc__footer {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border-subtle);
  }

  .doc__updated {
    color: var(--color-ink-muted);
  }

  .doc__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .doc__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-6);
    border: 1px solid var(--color-border-strong);
    border-radius: 8px;
    color: var(--color-ink);
    text-decoration: none;
  }

  .doc__link:hover {
    color: var(--color-action);
  }
</style>
