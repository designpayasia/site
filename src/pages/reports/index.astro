---
import { getCollection } from 'astro:content';

import Base from '../../layouts/Base.astro';
import CoverIndexSpread from '../../components/CoverIndexSpread.astro';
import EntryCard from '../../components/EntryCard.astro';
import MetricShelf from '../../components/MetricShelf.astro';

const entries = (await getCollection('reports', ({ data }) => data.status === 'published')).sort(
  (left, right) => right.data.publishedAt.getTime() - left.data.publishedAt.getTime(),
);

// Cross-cycle figures, derived from the entries rather than typed here, so a
// new cycle updates this page by landing its content file. All three cells
// cite one evidence entry (src/content/evidence/dpa-survey-cycles.json) —
// the single place to repoint when cycle data moves to a dataset layer. No
// cell is flagged 'signal': the shelf reports scale, not a finding.
// `?? 0` never fires: hub.responses.sampleSize is required by the schema's
// own refinement. It stands so a later schema relaxation surfaces as a wrong
// total rather than a type error here.
const totalResponses = entries.reduce(
  (sum, entry) => sum + (entry.data.hub.responses.sampleSize ?? 0),
  0,
);
const marketsCovered = new Set(entries.flatMap((entry) => entry.data.markets));
const years = entries.map((entry) => entry.data.year).sort((left, right) => left - right);
const yearRange =
  years.length > 1 ? `${years[0]}–${years[years.length - 1]}` : String(years[0] ?? '');

const CYCLES_EVIDENCE_ID = 'evidence:dpa-survey-cycles';

// Every cell states the same base, because every figure here is counted off
// the same responses. MetricShelf prints the raw evidence ID when a cell has
// no sample, so the caption is carried explicitly rather than left to fall back.
const shelfMetrics = [
  {
    value: totalResponses.toLocaleString('en-GB'),
    label: 'Responses across every cycle',
    evidenceId: CYCLES_EVIDENCE_ID,
    // No caption: this cell's value already is the sample, so `n=` would print
    // the same number twice. The other two cells are counted off it, so they say so.
    caption: '',
  },
  {
    value: String(marketsCovered.size),
    label: 'Markets covered',
    evidenceId: CYCLES_EVIDENCE_ID,
    sampleSize: totalResponses,
  },
  {
    value: String(entries.length),
    label: 'Survey cycles',
    evidenceId: CYCLES_EVIDENCE_ID,
    sampleSize: totalResponses,
  },
];

// The page's one outbound data link. When the survey data gets its own home,
// this is the only line to repoint — cards and shelf carry no data links.
const dataHref = '/docs/data-safety';
---

<Base
  title="Reports - Design Pay Asia"
  description="Evidence-backed reports on design compensation across Southeast Asia, with every metric linked to its source."
>
  <section class="reports-cover">
    <div class="reports-cover__inner">
      <CoverIndexSpread
        eyebrow="Reports"
        titleLines={['Designers and the numbers,', 'by year']}
        emphasis="by year"
        thesis="The survey runs all year. A report is one edition of it, compiled around a theme. Every figure links to the evidence behind it, and cohorts under ten stay unpublished."
        meta={yearRange ? [yearRange] : []}
      >
        {entries.length > 0 && <MetricShelf slot="metrics" metrics={shelfMetrics} />}
      </CoverIndexSpread>
    </div>
  </section>

  <section class="reports-list">
    <div class="reports-list__inner">
      <p class="label-mono reports-list__eyebrow">Every cycle</p>
      <div class="reports-list__grid">
        {
          entries.map((entry) => (
            <EntryCard
              href={entry.data.canonicalPath}
              year={entry.data.year}
              kind={entry.data.entryType}
              claim={entry.data.hub.claim}
              highlight={{
                value: entry.data.hub.highlight.value,
                unit: entry.data.hub.highlight.unit,
                label: entry.data.hub.highlight.label,
              }}
              meta={[
                `${entry.data.hub.responses.value} ${entry.data.hub.responses.label}`,
                `${entry.data.markets.length} ${entry.data.markets.length === 1 ? 'market' : 'markets'}`,
              ]}
            />
          ))
        }
      </div>
      <p class="reports-list__data">
        Each cycle publishes the figures behind it.
        <a href={dataHref}>How the data is collected, checked, and suppressed</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .reports-cover {
    padding-block: var(--space-24) var(--space-16);
  }

  .reports-cover__inner,
  .reports-list__inner {
    max-width: var(--site-max-width);
    margin-inline: auto;
    padding-inline: var(--space-8);
  }

  .reports-list {
    padding-block: var(--space-16) var(--space-24);
  }

  .reports-list__eyebrow {
    margin: 0 0 var(--space-6);
    color: var(--color-ink-muted);
  }

  /* Equal cards, newest first: one column on mobile, two from tablet up.
     Every entry keeps the same treatment whatever its year or kind, so a
     third cycle wraps onto the next row with nothing to change here. */
  .reports-list__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .reports-list__data {
    margin: var(--space-8) 0 0;
    max-width: var(--zone-prose);
    color: var(--color-ink-muted);
  }

  .reports-list__data a {
    color: var(--color-action);
    text-underline-offset: 0.2em;
  }

  .reports-list__data a:hover {
    color: var(--color-ink);
  }

  @media (min-width: 768px) {
    .reports-list__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .reports-cover,
    .reports-list {
      padding-inline: var(--space-4);
    }

    .reports-cover {
      padding-block: var(--space-16);
    }
  }
</style>
