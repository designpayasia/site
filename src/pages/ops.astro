---
import Base from '../layouts/Base.astro';
import { buildRouteInventory } from '../lib/routes.mjs';
import routePurposes from '../data/route-purposes.json';

const ownershipRows = [
  {
    surface: 'Publication approvals',
    owner: 'Jonathan',
    backup: 'Decision stays manual',
    status: 'Active',
  },
  {
    surface: 'Schema and content migration',
    owner: 'Repo maintainers + AI drafting',
    backup: 'Git history and public ops page',
    status: 'Active',
  },
  {
    surface: 'Editorial cadence',
    owner: 'Decision pending',
    backup: 'Not yet assigned',
    status: 'Open gate',
  },
  {
    surface: 'Infrastructure and deploy',
    owner: 'GitHub repo maintainers',
    backup: 'Node 22 + CI contract',
    status: 'Active',
  },
];

const routeRows = buildRouteInventory(routePurposes);
---

<Base
  title="Ops - Design Pay Asia"
  description="Public continuity notes, architecture map, ownership matrix, and publication contract for Design Pay Asia."
>
  <section class="ops-hero">
    <div class="ops-hero__inner">
      <p class="label-mono">Ops</p>
      <h1 class="t-h2">Public continuity spine for the site.</h1>
      <p class="prose">
        This page names the public contract: structured content, evidence-backed claims,
        Node 22 runtime, and manual approval for publish decisions that affect trust.
        If you are picking this project up cold, start here, then read the
        <a href="/docs">docs</a>.
      </p>
    </div>
  </section>

  <section class="ops-grid">
    <div class="ops-grid__inner">
      <article class="ops-card">
        <h2>Publication contract</h2>
        <ul>
          <li>Every published homepage or report metric needs an `evidenceId`.</li>
          <li>Cohorts smaller than 10 must be sampled or suppressed.</li>
          <li>Reports publish at year-namespaced routes under `/reports/`.</li>
          <li>Redirect changes must update the redirect manifest and generated `_redirects` file.</li>
        </ul>
      </article>

      <article class="ops-card">
        <h2>Recovery floor</h2>
        <ul>
          <li>Run `nvm use` to match `.nvmrc` before local work.</li>
          <li>CI runs on Node 22 and checks build, routes, and content diagnostics.</li>
          <li>GitHub history is the public rollback path for content and route contracts.</li>
          <li>Private handoff packets stay outside this repo.</li>
        </ul>
      </article>

      <article class="ops-card">
        <h2>Architecture</h2>
        <ul>
          <li>Static Astro build. Routes live under `src/pages` and stay year-namespaced for published reports.</li>
          <li>Collections are defined in `src/content.config.ts` and loaded from `src/content/site`, `src/content/reports`, `src/content/evidence`, and `src/content/docs`.</li>
          <li>Redirect rules live in `src/data/redirects.json` and generate `public/_redirects` through `scripts/redirects.mjs`.</li>
          <li>CI proves redirects, token usage, ops freshness, link integrity, content checks, and the full static build.</li>
        </ul>
      </article>

      <article class="ops-card">
        <h2>Succession</h2>
        <ul>
          <li>This page and the docs are the whole public handover. There is no private supplement that explains the build.</li>
          <li>Use Node 22 and run the documented checks before changing routes or published figures.</li>
          <li>Evidence and data-safety rules are trust floors. Where provenance is weak, defer rather than publish.</li>
          <li>Account ownership, 2FA, and recovery packets stay outside this public repository.</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="ops-ownership">
    <div class="ops-ownership__inner">
      <h2 class="t-h2">Ownership matrix</h2>
      <div class="ops-table-wrap">
        <table class="ops-table">
          <thead>
            <tr>
              <th scope="col" class="label-mono">Surface</th>
              <th scope="col" class="label-mono">Owner</th>
              <th scope="col" class="label-mono">Fallback</th>
              <th scope="col" class="label-mono">Status</th>
            </tr>
          </thead>
          <tbody>
            {ownershipRows.map((row) => (
              <tr>
                <td>{row.surface}</td>
                <td>{row.owner}</td>
                <td>{row.backup}</td>
                <td><span class="label-mono ops-table__status">{row.status}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="ops-ownership">
    <div class="ops-ownership__inner">
      <h2 class="t-h2">Route inventory</h2>
      <p class="prose ops-note">
        Generated at build time from `src/pages` and the content collections, so it cannot
        fall behind what ships. Purposes are held in `src/data/route-purposes.json`.
      </p>
      <div class="ops-table-wrap">
        <table class="ops-table">
          <thead>
            <tr>
              <th scope="col" class="label-mono">Route</th>
              <th scope="col" class="label-mono">Purpose</th>
              <th scope="col" class="label-mono ops-table__value">Pages</th>
            </tr>
          </thead>
          <tbody>
            {routeRows.map((row) => (
              <tr>
                <td>{row.pattern}</td>
                <td>{row.purpose}</td>
                <td class="ops-table__value">{row.count}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>

<style>
  .ops-hero {
    padding-block: var(--space-24) var(--space-12);
  }

  .ops-hero__inner {
    max-width: var(--site-max-width);
    margin-inline: auto;
    padding-inline: var(--space-8);
  }

  .ops-hero__inner h1 {
    margin-block: var(--space-6);
    max-width: 12ch;
  }

  .ops-ownership__inner h2 {
    margin-block: var(--space-4) var(--space-3);
  }

  .ops-grid {
    padding-block: var(--space-12);
  }

  .ops-grid__inner {
    max-width: var(--site-max-width);
    margin-inline: auto;
    padding-inline: var(--space-8);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
  }

  .ops-card {
    padding: var(--space-10);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-blob-motif);
    background: var(--color-surface);
  }

  .ops-card ul {
    margin-top: var(--space-4);
    padding-left: var(--space-5);
    color: var(--color-ink-muted);
  }

  .ops-card li + li {
    margin-top: var(--space-2);
  }

  .ops-ownership {
    padding-block: var(--space-12) var(--space-24);
  }

  .ops-ownership__inner {
    max-width: var(--site-max-width);
    margin-inline: auto;
    padding-inline: var(--space-8);
  }

  .ops-note {
    margin-top: var(--space-4);
    color: var(--color-ink-muted);
  }

  .ops-table-wrap {
    overflow-x: auto;
    margin-top: var(--space-8);
  }

  .ops-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .ops-table th,
  .ops-table td {
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
    vertical-align: top;
  }

  .ops-table th {
    color: var(--color-ink-muted);
  }

  /* Quiet mono treatment for the ownership matrix's status values —
     data-voice register, restrained rather than a badge or pill. */
  .ops-table__status {
    color: var(--color-ink-muted);
  }

  /* Route inventory's page count is numeric — set in the data face,
     tabular and right-aligned so digits line up, matching ChartBlock's
     fallback-table value column. */
  .ops-table td.ops-table__value {
    font-family: var(--font-data);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  .ops-table th.ops-table__value {
    text-align: right;
  }

  @media (max-width: 900px) {
    .ops-grid__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .ops-hero,
    .ops-grid,
    .ops-ownership {
      padding-inline: var(--space-4);
    }

    .ops-hero {
      padding-block: var(--space-16) var(--space-8);
    }
  }
</style>
